# Untuk dev lokal: arahkan request /api/* ke server Python.
# Jalankan server:  .venv\Scripts\python -m uvicorn dev_server:app --port 8000
# Lalu start Next.js dengan env ini:  $env:LOCAL_PROXY="1"; npm run dev
LOCAL_PROXY=1

# Opsional (tidak wajib): jika API dipisah di host lain
# NEXT_PUBLIC_API_BASE=http://localhost:8000
